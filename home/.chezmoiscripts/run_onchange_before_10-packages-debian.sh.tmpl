{{- if eq .family "debian" -}}
#!/bin/sh
# apt packages, rendered in from .chezmoidata/packages.toml so chezmoi's content
# hash changes — and this re-runs — only when a package is added or removed.
#
# Assumes run_onchange_before_05-repos-debian.sh has already added the
# third-party sources and run `apt-get update`. Needs sudo.

set -eu

export DEBIAN_FRONTEND=noninteractive

# One batch: everything here comes from Debian's own repositories, so a name
# that will not resolve means a broken machine rather than a missing extra, and
# the whole install should fail rather than limp on.
sudo apt-get install -y \
{{ range $i, $p := .packages.debian.core }}{{ if $i }} \
{{ end }}    {{ $p }}{{ end }}

# Docker is its own batch, guarded on the source 05-repos-debian is allowed to
# skip. Inside the batch above, five unresolvable packages would take zsh —
# installed by that same batch, and what the bootstrap tells you to `exec` —
# down with them.
if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
    echo "  ! no Docker apt source, skipping {{ .packages.debian.docker | join " " }}"
elif sudo apt-get install -y \
{{ range $i, $p := .packages.debian.docker }}{{ if $i }} \
{{ end }}    {{ $p }}{{ end }}; then
    echo "  + docker"
else
    echo "  ! could not install Docker; 36-linux-services will skip it"
fi

{{ if .isWSL -}}
echo "  . wsl: the desktop apps come from the Windows host, skipped"
{{- else -}}
# One at a time, unlike the batch above. Each of these comes from a third-party
# repo the repo script is allowed to skip when a key fetch fails, and one
# unavailable app should not take the other four down with it.
for pkg in {{ .packages.debian.desktop | join " " }}; do
    if dpkg -s "$pkg" >/dev/null 2>&1; then
        echo "  . $pkg"
    elif sudo apt-get install -y "$pkg"; then
        echo "  + $pkg"
    else
        echo "  ! could not install $pkg"
    fi
done
{{- end }}
{{ end -}}
