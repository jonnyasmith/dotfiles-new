# .chezmoiroot points chezmoi at home/, so README.md, docs/ and .github/ at the
# repo root are already invisible to it and need no entry here.
#
# ~/.config/git/config.local and config.work are NOT listed: they are templates
# that render empty on a personal machine, and chezmoi removes a target that
# renders empty. The gate is the answers to `chezmoi init`, not this file.

{{ if eq .family "windows" -}}
# A bash script, and the one thing here with no Windows equivalent. The stubs
# and ~/.ssh/config it maintains are still applied.
.ssh/1password/refresh

# The ~/dev checkouts these point at live in the WSL guest, not on the host, so
# every one of these would be a dangling link — and creating a symlink at all
# on Windows needs Developer Mode or an elevated shell. .chezmoiexternal.toml
# renders empty here for the same reason.
.agents
.claude/CLAUDE.md
.claude/skills
.local/bin/wt
.local/bin/worktree
{{ end -}}

{{ if ne .family "darwin" -}}
# Karabiner-Elements is macOS-only. Its config is a keyboard remap for a
# keyboard driver that cannot exist anywhere else.
.config/karabiner
{{ end -}}

{{ if eq .family "windows" -}}
# tmux does not run on Windows, and btop and htop are POSIX process viewers.
# kitty has no Windows build at all. The rest of the app configs here are
# cross-platform and stay — nvim, gh, git, starship, mise and the AI CLIs all
# read the same ~/.config tree once the PowerShell profile names
# XDG_CONFIG_HOME.
.config/tmux
.config/btop
.config/htop
.config/kitty

# zsh is the login shell everywhere except here. On a dual-boot or WSL machine
# the guest has its own $HOME and gets its own apply, so a copy on the host
# would be read by nothing.
.zshrc
.zshenv
.zprofile
.config/zsh
{{ end -}}

{{ if ne .family "windows" -}}
# Windows-only paths, and the two things here that are not under ~/.config.
# Windows Terminal is a Store app, so its settings live under the package
# identity; pwsh's profile has a fixed name and directory.
AppData
Documents
{{ end -}}

{{ if not (lookPath "cosmic-comp") -}}
# COSMIC settings, one file per key. Unlike every other gate here this is a
# live probe rather than a machine fact: .chezmoiignore is re-rendered on every
# apply, so installing COSMIC later is enough to bring ~/.config/cosmic under
# management, with no `chezmoi init` needed.
.config/cosmic
{{ end -}}

{{ if .isWSL -}}
# 1Password runs on the Windows host under WSL, and its agent config is read
# there. A copy inside the guest is read by nothing.
.config/1Password
{{ end -}}
