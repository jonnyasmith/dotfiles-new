# Work account routing. Copy to ~/.config/git/config.local and fill in.
#
#     cp ~/.dotfiles/home/.config/git/config.local.example ~/.config/git/config.local
#
# Replace ORG with the GitHub org. The host alias `github-work` is defined in
# ~/.ssh/config and pins the work 1Password key - do not change it here without
# changing it there.
#
# Add another [url] block plus its two [includeIf] blocks per extra work org.

[url "git@github-work:ORG/"]
    insteadOf = git@github.com:ORG/
    insteadOf = ssh://git@github.com/ORG/

# Both spellings, because hasconfig matches the URL as *stored* in the repo,
# before the rewrite above is applied.
[includeIf "hasconfig:remote.*.url:git@github.com:ORG/**"]
    path = config.work
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/ORG/**"]
    path = config.work

# And create ~/.config/git/config.work with just the work identity:
#
#     [user]
#         email = you@example.com
#
# Azure DevOps repos pick this up too, via an [includeIf] in the tracked config.
